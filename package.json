{
  "name": "evone",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter @evone/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test:unit test:e2e",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "verify:gates": "node scripts/verify-quality-gates.mjs",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:migrate:dev": "pnpm --filter @evone/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @evone/db migrate:deploy",
    "db:migrate:status": "pnpm --filter @evone/db migrate:status",
    "db:migrate:rollback": "pnpm --filter @evone/db migrate:rollback",
    "db:migrate:verify": "pnpm --filter @evone/db migrate:verify",
    "contract:generate": "turbo run contract:generate",
    "contract:check": "turbo run contract:generate && git diff --exit-code -- packages/contracts/openapi.json packages/sdk/src/schema.ts",
    "test:integration": "turbo run test:integration",
    "db:seed:demo": "pnpm --filter @evone/db seed:demo"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
