# Root-level example. App-specific variables live beside each app:
#   apps/api/.env.example  (DATABASE_URL, REDIS_URL, API_*)
# Local database from `pnpm db:up` (infra/docker/docker-compose.yml):
DATABASE_URL=postgresql://evone:evone_local_only@127.0.0.1:5432/evone
SHADOW_DATABASE_URL=postgresql://evone:evone_local_only@127.0.0.1:5432/evone_shadow
# Never place private credentials in NEXT_PUBLIC_ variables.

# Private queue connection; use rediss:// for managed production Redis.
REDIS_URL=redis://127.0.0.1:6379
