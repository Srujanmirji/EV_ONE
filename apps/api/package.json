{
  "name": "@evone/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import @swc-node/register/esm-register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@evone/contracts": "workspace:*",
    "@evone/db": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@evone/sdk": "workspace:*",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.21",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
