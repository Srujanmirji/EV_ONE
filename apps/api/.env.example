# Copy to apps/api/.env for local overrides. DATABASE_URL is required; the
# rest show their defaults. Real credentials never belong in this file.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
API_READINESS_TIMEOUT_MS=2000
DATABASE_URL=postgresql://evone:evone_local_only@127.0.0.1:5432/evone
# Error tracking (EV-019). Unset = off. Never commit a real DSN.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# APP_RELEASE=<git sha>
LOG_LEVEL=info
