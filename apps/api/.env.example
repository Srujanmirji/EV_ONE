# Copy to apps/api/.env for local overrides. DATABASE_URL is required; the
# rest show their defaults. Real credentials never belong in this file.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
API_READINESS_TIMEOUT_MS=2000
DATABASE_URL=postgresql://evone:evone_local_only@127.0.0.1:5432/evone

# Private queue connection; use rediss:// for managed production Redis.
REDIS_URL=redis://127.0.0.1:6379

# Optional Sentry reporting. Leave absent to keep external telemetry disabled.
# SENTRY_DSN=<project HTTPS DSN from Sentry; never commit a real value>

# EV-016 local-only authentication. Disabled by default; production refuses clerk-local.
AUTH_MODE=disabled
# To enable locally, use the same development instance/template as EV-005:
# AUTH_MODE=clerk-local
# AUTH_ISSUER=https://<development-instance>.clerk.accounts.dev
# AUTH_AUDIENCE=evone-api-development
# AUTH_AUTHORIZED_PARTY=http://127.0.0.1:3000
# AUTH_JWT_KEY=<RSA-2048 SPKI public PEM, never a private key>

# EV-020 private media, disabled by default; production/public API binds refuse r2-local.
MEDIA_MODE=disabled
# Enable only with local Clerk auth and a private development bucket or local S3 fixture.
# MEDIA_MODE=r2-local
# MEDIA_ENDPOINT=https://<32-character-account-id>.r2.cloudflarestorage.com
# MEDIA_BUCKET=<private-development-bucket>
# MEDIA_ACCESS_KEY_ID=<local secret, never commit>
# MEDIA_SECRET_ACCESS_KEY=<local secret, never commit>
