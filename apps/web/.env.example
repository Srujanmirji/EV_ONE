# Copy to apps/web/.env.local for local development.
# Server-side only (never NEXT_PUBLIC_): the web server calls the API.
API_BASE_URL=http://127.0.0.1:4000
# Absolute origin for canonical URLs and sitemap.xml.
PUBLIC_WEB_URL=http://127.0.0.1:3000

# EV-005 isolated local Clerk spike. Disabled outside NODE_ENV=development.
# Leave disabled until a development Clerk application is available.
AUTH_SPIKE_ENABLED=false
AUTH_SPIKE_CLERK_PUBLISHABLE_KEY=
AUTH_SPIKE_CLERK_ISSUER=
AUTH_SPIKE_AUDIENCE=evone-api-development
AUTH_SPIKE_ORIGIN=http://127.0.0.1:3000
# RSA 2048-bit PUBLIC PEM key from the development instance; never a private key.
AUTH_SPIKE_CLERK_JWT_KEY=

# EV-022 local catalogue workspace. Requires the configured EV-005 local Clerk spike.
# Disabled outside development regardless of this value; API auth remains independently guarded.
CATALOGUE_EDITOR_ENABLED=false
