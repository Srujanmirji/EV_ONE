{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "src/generated/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "API_HOST",
        "API_PORT",
        "API_READINESS_TIMEOUT_MS",
        "API_BASE_URL",
        "PUBLIC_WEB_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "typecheck": {
      "outputs": [".next/types/**"],
      "dependsOn": ["^build", "generate"]
    },
    "test:unit": {
      "dependsOn": ["^build", "generate"]
    },
    "test:e2e": {
      "dependsOn": ["build", "@evone/api#build"],
      "cache": false,
      "passThroughEnv": [
        "PW_CHROMIUM_EXECUTABLE",
        "CI",
        "DATABASE_URL",
        "REDIS_URL"
      ]
    },
    "contract:generate": {
      "dependsOn": ["build", "^contract:generate"],
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "REDIS_URL"]
    },
    "generate": {
      "outputs": ["src/generated/**"]
    }
  }
}
