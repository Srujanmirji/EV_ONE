// EVONE data model. Conventions: DATABASE.md. PostGIS rules: ADR-012
// (spatial columns are nullable `Unsupported("geography(Point, 4326)")?`
// with `@@index([col], type: Gist)`; spatial SQL stays in one repository).
// Domain tables arrive with their tasks (EV-021 catalogue, EV-027 listings).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["postgresqlExtensions", "partialIndexes"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// ── Catalogue (EV-021) ────────────────────────────────────────────────────
// Specs are nullable: NULL means "unknown", never zero. A variant can only
// be PUBLISHED when every non-null spec has a reviewed https source in
// spec_sources (enforced by database triggers, see the EV-021 migration).

enum PublishStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum VehicleType {
  SCOOTER
  MOTORCYCLE
  CAR
  THREE_WHEELER
}

enum ModelAvailability {
  ON_SALE
  UPCOMING
  DISCONTINUED
  UNKNOWN
}

/// Test cycle a claimed range was measured under. Ranges from different
/// standards are not comparable and must never be shown without it.
enum RangeStandard {
  MIDC
  IDC
  WLTP
  NEDC
  EPA
  OEM_UNSPECIFIED
}

/// Variant columns a spec_sources row can cite. range covers both
/// claimed_range_km and range_standard.
enum SpecField {
  BATTERY_KWH
  CLAIMED_RANGE
  MOTOR_KW
  CHARGING_AC_KW
  CHARGING_DC_KW
  WARRANTY
}

enum SourceKind {
  OEM
  REGULATOR
  PRESS
  DEALER
  OTHER
}

model Brand {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  slug      String        @unique
  logoKey   String?       @map("logo_key")
  status    PublishStatus @default(DRAFT)
  isDemo    Boolean       @default(false) @map("is_demo")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  models    EvModel[]

  @@map("brands")
}

model EvModel {
  id                 String            @id @default(uuid()) @db.Uuid
  brandId            String            @map("brand_id") @db.Uuid
  name               String
  slug               String
  vehicleType        VehicleType       @map("vehicle_type")
  availabilityStatus ModelAvailability @default(UNKNOWN) @map("availability_status")
  releaseDate        DateTime?         @map("release_date") @db.Date
  status             PublishStatus     @default(DRAFT)
  isDemo             Boolean           @default(false) @map("is_demo")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  brand              Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  variants           EvVariant[]
  catalogueDrafts     CatalogueDraft[]

  @@unique([brandId, slug])
  @@index([status, vehicleType])
  @@map("ev_models")
}

model EvVariant {
  id             String         @id @default(uuid()) @db.Uuid
  modelId        String         @map("model_id") @db.Uuid
  name           String
  slug           String
  batteryKwh     Decimal?       @map("battery_kwh") @db.Decimal(6, 2)
  claimedRangeKm Int?           @map("claimed_range_km")
  rangeStandard  RangeStandard? @map("range_standard")
  motorKw        Decimal?       @map("motor_kw") @db.Decimal(6, 2)
  chargingAcKw   Decimal?       @map("charging_ac_kw") @db.Decimal(5, 2)
  chargingDcKw   Decimal?       @map("charging_dc_kw") @db.Decimal(6, 2)
  warrantyText   String?        @map("warranty_text")
  status         PublishStatus  @default(DRAFT)
  isDemo         Boolean        @default(false) @map("is_demo")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  model          EvModel        @relation(fields: [modelId], references: [id], onDelete: Restrict)
  sources        SpecSource[]
  listings       Listing[]

  @@unique([modelId, slug])
  @@index([status])
  @@map("ev_variants")
}

model SpecSource {
  id          String     @id @default(uuid()) @db.Uuid
  variantId   String     @map("variant_id") @db.Uuid
  fieldName   SpecField  @map("field_name")
  /// The value exactly as the source states it, for reviewer comparison.
  valueText   String     @map("value_text")
  sourceUrl   String     @map("source_url")
  sourceKind  SourceKind @map("source_kind")
  effectiveAt DateTime?  @map("effective_at") @db.Date
  /// Set when a reviewer has checked the value against the source.
  reviewedAt  DateTime?  @map("reviewed_at") @db.Timestamptz(6)
  /// users.id once identity exists (EV-016); no FK until then.
  reviewerId  String?    @map("reviewer_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  variant     EvVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, fieldName])
  @@map("spec_sources")
}

// ── Identity and scoped authorization (EV-017, local-only) ────────────────
enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AppRole {
  USER
  DEALER_STAFF
  DEALER_OWNER
  EDITOR
  MODERATOR
  ADMIN
}

enum RoleScope {
  GLOBAL
  DEALER
}

enum AccessScope {
  ACCOUNT
  DEALER
}

enum AuditAction {
  LISTING_ACCESS
  LISTING_SUBMIT
  CATALOGUE_READ
  CATALOGUE_WRITE
  CATALOGUE_SUBMIT
  CATALOGUE_REVIEW
  MEDIA_UPLOAD
  MEDIA_COMPLETE
  MEDIA_READ
  ACCESS_CHECK
}

enum AuditOutcome {
  ALLOWED
  DENIED
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  authIssuer     String           @map("auth_issuer") @db.VarChar(512)
  authProviderId String           @map("auth_provider_id") @db.VarChar(256)
  status         UserStatus       @default(SUSPENDED)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles          RoleAssignment[]
  auditEvents    AuditEvent[]
  mediaAssets    MediaAsset[]
  listings       Listing[]
  listingReviews ListingReview[]
  listingHistory ListingHistory[]
  catalogueDrafts CatalogueDraft[] @relation("DraftOwner")
  catalogueReviews CatalogueDraft[] @relation("DraftReviewer")

  @@unique([authIssuer, authProviderId])
  @@map("users")
}

model RoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      AppRole
  scopeType RoleScope @map("scope_type")
  scopeId   String?   @map("scope_id") @db.Uuid
  active    Boolean   @default(true)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, role], where: raw("scope_id IS NULL"), map: "role_assignments_global_key")
  @@unique([userId, role, scopeId], where: raw("scope_id IS NOT NULL"), map: "role_assignments_dealer_key")
  @@index([userId])
  @@map("role_assignments")
}

model AuditEvent {
  id          String       @id @default(uuid()) @db.Uuid
  actorUserId String?      @map("actor_user_id") @db.Uuid
  scope       AccessScope
  scopeId     String       @map("scope_id") @db.Uuid
  resourceId  String?      @map("resource_id") @db.Uuid
  action      AuditAction  @default(ACCESS_CHECK)
  outcome     AuditOutcome
  requestId   String       @map("request_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

// Private media only. Public/listing attachment policy belongs to EV-028.
enum MediaStatus {
  PENDING
  READY
  REJECTED
}

model MediaAsset {
  id          String      @id @default(uuid()) @db.Uuid
  ownerId     String      @map("owner_id") @db.Uuid
  contentType String      @map("content_type") @db.VarChar(32)
  sizeBytes   Int         @map("size_bytes")
  objectKey   String?     @map("object_key") @db.VarChar(160)
  status      MediaStatus @default(PENDING)
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  listingMedia ListingMedia[]

  @@index([ownerId, status])
  @@map("media_assets")
}

enum CatalogueDraftStatus {
  DRAFT
  IN_REVIEW
  REJECTED
  PUBLISHED
}

model CatalogueDraft {
  id           String @id @default(uuid()) @db.Uuid
  ownerId      String @map("owner_id") @db.Uuid
  document     Json @db.JsonB
  version      Int @default(1)
  status       CatalogueDraftStatus @default(DRAFT)
  reviewReason String? @map("review_reason") @db.VarChar(500)
  reviewerId   String? @map("reviewer_id") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  modelId      String? @map("model_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner        User @relation("DraftOwner",fields:[ownerId],references:[id],onDelete:Restrict)
  reviewer     User? @relation("DraftReviewer",fields:[reviewerId],references:[id],onDelete:Restrict)
  model        EvModel? @relation(fields:[modelId],references:[id],onDelete:Restrict)

  @@index([ownerId,id])
  @@index([reviewerId])
  @@index([modelId])
  @@map("catalogue_drafts")
}

// Marketplace foundation (EV-027). No listing API or public reads are enabled.
enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
  SOLD
}

enum ListingReviewDecision {
  APPROVE
  REJECT
}

model Listing {
  id               String @id @default(uuid()) @db.Uuid
  sellerUserId     String @map("seller_user_id") @db.Uuid
  preferredVehicleType VehicleType? @map("preferred_vehicle_type")
  variantId        String? @map("variant_id") @db.Uuid
  slug             String @unique @db.VarChar(160)
  year             Int?
  odometerKm       Int? @map("odometer_km")
  city             String? @db.VarChar(120)
  askingPricePaise BigInt? @map("asking_price_paise")
  ownershipCount   Int? @map("ownership_count")
  conditionNotes   String? @map("condition_notes") @db.VarChar(3000)
  status           ListingStatus @default(DRAFT)
  version          Int @default(1)
  isDemo           Boolean @default(true) @map("is_demo")
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  seller           User @relation(fields:[sellerUserId],references:[id],onDelete:Restrict)
  variant          EvVariant? @relation(fields:[variantId],references:[id],onDelete:Restrict)
  media            ListingMedia[]
  reviews          ListingReview[]
  history          ListingHistory[]

  @@index([sellerUserId,status])
  @@index([variantId])
  @@index([status,publishedAt])
  @@index([status,askingPricePaise])
  @@index([city,status])
  @@map("listings")
}

model ListingMedia {
  id           String @id @default(uuid()) @db.Uuid
  listingId    String @map("listing_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  position     Int
  alt          String @db.VarChar(300)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  listing      Listing @relation(fields:[listingId],references:[id],onDelete:Restrict)
  asset        MediaAsset @relation(fields:[mediaAssetId],references:[id],onDelete:Restrict)

  @@unique([listingId,position])
  @@unique([listingId,mediaAssetId])
  @@index([mediaAssetId])
  @@map("listing_media")
}

model ListingReview {
  id              String @id @default(uuid()) @db.Uuid
  listingId       String @map("listing_id") @db.Uuid
  listingVersion  Int @map("listing_version")
  reviewerId      String @map("reviewer_id") @db.Uuid
  decision        ListingReviewDecision
  reason          String? @db.VarChar(500)
  snapshot        Json @db.JsonB
  requestId       String @map("request_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  listing         Listing @relation(fields:[listingId],references:[id],onDelete:Restrict)
  reviewer        User @relation(fields:[reviewerId],references:[id],onDelete:Restrict)

  @@unique([listingId,listingVersion])
  @@index([reviewerId])
  @@map("listing_reviews")
}

model ListingHistory {
  id          String @id @default(uuid()) @db.Uuid
  listingId   String @map("listing_id") @db.Uuid
  version     Int
  actorUserId String @map("actor_user_id") @db.Uuid
  fromStatus  ListingStatus? @map("from_status")
  toStatus    ListingStatus @map("to_status")
  beforeJson  Json? @map("before_json") @db.JsonB
  afterJson   Json @map("after_json") @db.JsonB
  requestId   String @map("request_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  listing     Listing @relation(fields:[listingId],references:[id],onDelete:Restrict)
  actor       User @relation(fields:[actorUserId],references:[id],onDelete:Restrict)

  @@unique([listingId,version])
  @@index([actorUserId,createdAt])
  @@map("listing_history")
}
